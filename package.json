{
  "name": "playwright-e2e-tests",
  "version": "1.0.0",
  "description": "playwright E2E Tests with AI Capabilities Incld MCP",
  "keywords": [
    "playwright",
    "playwright-e2e-tests",
    "playwright-mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git@github-personal:SatyaVeera1994/playwright-e2e-tests.git"
  },
  "license": "ISC",
  "author": "satya automation,",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "makemytripbookingtickets": "npx playwright test --config=config/test.playwright.config.ts tests/e2e/makemytrip/booktheflight.spec.ts --headed",
    "test:e2e:login:makeAptmnt": "npx playwright test --config=config/test.playwright.config.ts tests/e2e/cura.healthcare.service/login.e2e.spec.ts --headed",
    "portal:e2e:login:makeAptmnt": "npx playwright test --config=config/test.playwright.config.ts tests/e2e/portaldhaboard/login.portal.spec.ts --headed",
    "dev:makeAptmnt": "npx playwright test --config=config/dev.playwright.config.ts tests/functional/make.aptmnt.spec.ts --headed",
    "test:makeAptmnt": "npx playwright test --config=config/test.playwright.config.ts tests/functional/make.aptmnt.spec.ts --headed",
    "demoglobal": "npx playwright test tests/demo/coverfox.spec.ts ",
    "`pw-adv-debug-cap`": "cross-env DEBUG=pw:api playwright test tests/functional/make.aptmnt.spec.ts --headed",
    "makeAptmnt": "npx playwright test tests/functional/make.aptmnt.spec.ts --headed",
    "pw-basic-cap": "npx playwright test tests/demo/pw.basic.cap.make.aptmnt.spec.ts --headed",
    "inventory": "npx playwright test tests/functional/inventory.spec.ts --headed",
    "multi-window": "npx playwright test tests/functional/multi.window.spec.ts --headed",
    "debug": "npx playwright test tests/demo/debug_inventory.spec.ts --headed",
    "debug:ui": "npx playwright test tests/demo/debug_inventory.spec.ts --ui --headed",
    "debug:cli": "cross-env PWDEBUG=1 npx playwright test tests/demo/debug_inventory.spec.ts",
    "debug:trace": "npx playwright test tests/demo/debug_inventory.spec.ts --trace on",
    "myfirsttest": "npx playwright test tests/demo/1_myfirsttest.spec.ts --headed",
    "amazonsearch": "npx playwright test tests/functional/amazonSearch.spec.ts --headed",
    "addpacakger:cli": "npx playwright test tests/e2e/portaldhaboard/add.packager.spec.ts --trace on",
    "addpacakger": "npx playwright test tests/e2e/portaldhaboard/add.packager.spec.ts --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^25.9.5",
    "allure-playwright": "^3.10.0",
    "chalk": "^5.6.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2"
  }
}
